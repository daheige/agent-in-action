DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-xxxx
# 使用的模型
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_INPUT_PER_1M_USD=12
DEEPSEEK_OUTPUT_PER_1M_USD=20
DEEPSEEK_LATENCY_HINT_MS=20000
LLM_PROVIDER_ORDER=deepseek
# 路由策略: priority|cheapest|latency，默认为 priority
LLM_STRATEGY=priority

# HTTP 服务配置（cmd/web）
PORT=8080
WEB_REQUEST_TIMEOUT=60s
# CORS 允许的 Origin，多个用逗号分隔，* 表示允许任意 Origin；留空则不启用 CORS
WEB_CORS_ORIGINS=*
